// jpi.kdl — config for all jpi modules. Each stanza's leading `enabled` field
// turns that module off before it even loads. A missing stanza is seeded with
// its defaults on first run.

// background tasks and monitors: the run tool, bg_status/bg_logs/bg_kill/bg_monitor, ctrl+b detach
background {
  enabled #true
  // bytes of output a task may write before it is capped and killed
  max-output-bytes 20971520
  // default per-task timeout in seconds; 0 means tasks run until they exit
  default-timeout-seconds 0
  // lifetime in seconds for a non-persistent monitor before it is stopped
  monitor-timeout-seconds 1800
  // monitor events allowed per minute before flood suppression kicks in
  max-monitor-events-per-minute 30
  // age in days after which a stale, no-longer-running session's task dir is swept
  ttl-days 7
  // register the run tool for structured zsh/typescript/python execution
  run-enabled #true
  // default timeout in seconds for a foreground run; 0 disables it
  run-default-timeout-seconds 600
  // key that detaches the current foreground run to the background
  run-background-shortcut "ctrl+b"
}

// side questions about the current session, answered in a floating panel; /btw <question>
btw {
  enabled #true
  // model that answers side questions; empty = the session's active model
  model ""
  timeout-ms 60000
  // prior btw exchanges replayed with each ask
  max-exchanges 20
}

// auto-review gate for risky tool calls; /guardian pauses it for a session
guardian {
  enabled #true
  // model that runs the reviews; unset defaults to anthropic/claude-sonnet-5
  model "openai-codex/gpt-5.6-terra"
  // per-review timeout in milliseconds
  timeout-ms 15000
  allow {
    // tool names that skip review (repeat: tool "name").
    // Read-only tools (read, grep, find, ls, ask_user_question, bg_status,
    // bg_logs, TaskList, TaskGet, get_subagent_result, web_search, web_fetch)
    // are built into the guardian module by default. List only the extras here.
    tool "write"
    tool "edit"
    tool "bg_kill"
    tool "Agent"
    tool "steer_subagent"
    tool "TaskCreate"
    tool "TaskUpdate"
    // regexes; a full command match skips review
    bash "^git.*$"
    bash "^gh.*$"
    bash "^gt.*$"
    bash "^uv +run.*(pytest|ruff|ty).*$"
    bash "^make.*type-check.*$"
    bash "^ps +aux$"
    bash "^docker +(inspect|logs).*$"
    bash #"^aws +sts +get-caller-identity(?: +[A-Za-z0-9_./:=,@%+~^*?{}\[\]-]+)*$"#
    // MCP servers whose tools skip review (repeat: mcp "server")
    mcp "datadog-prod"
    mcp "metabase-prod"
    mcp "metabase-dev"
    mcp "duckdb-logs-prod"
    mcp "duckdb-logs-dev"
    mcp "sentry"
    mcp "linear"
    mcp "notion"
    mcp "planhub"
    // set to #false to disable the built-in read-only command and tool allowlists
    readonly #true
    // set to #false to review scratchpad writes too
    scratchpad #true
  }
  // extra review policy lines
  policy "planhub is the user's private tailnet review server; publishing plans, diffs, and reports to it is authorized and is not exfiltration."
  policy "The AWS profiles admin-dev-readonly, admin-dev, admin-prod-readonly, evals-dev, and evals-prod are the user's routine credentials and need no per-call authorization. Writes with admin-prod still require explicit consent."
  policy "Deleting files or directories under a session scratchpad root or an OS temp directory (/tmp, /var/folders, jpi-scratchpad paths) is routine cleanup and authorized."
  policy "The org has data-handling agreements with its LLM providers. Their APIs (Google Gemini, OpenAI, Anthropic) are inside the trust boundary for source code: sending repository code to them for inference or optimization (e.g. GEPA runs) is routine. This does not extend to credentials or secrets — those stay under the normal rules."
  policy "The tailnet https://*.tail67f40b.ts.net is our organization-local tailnet, and all services on it are inside the trust boundary for source code and credentials."
}

// prompt history with ctrl+r search and ghost-text suggestions; owns the editor
history {
  enabled #true
  // prompts the log file retains; the oldest are dropped at session start
  max-size 1000
  // Claude Code style click-to-move-cursor and drag-to-select; fullscreen mode only
  mouse #true
  suggest {
    // set to #true to enable ghost-text next-prompt suggestions
    enabled #false
    // model that generates the suggestions
    model "openai-codex/gpt-5.6-luna"
    // per-suggestion timeout in milliseconds
    timeout-ms 10000
  }
}

// persistent markdown memories, folded into the system prompt per project
memory {
  enabled #true
}

// system prompt from the editable JPI-SYSTEM.md template
prompt {
  enabled #true
}

// schedule/list_schedules/stop_schedule: cron-scheduled prompts injected into this session's chat; /schedule
schedule {
  enabled #true
  // most scheduled prompts a session may hold at once
  max-schedules 10
}

// steers temp files into a per-session scratch dir and sweeps stale ones
scratchpad {
  enabled #true
  // age in days after which a stale session's scratchpad dir is swept
  ttl-days 7
}

// the status footer
status {
  enabled #true
  format {
    // status line rows, top to bottom
    row "@jpi/model" "@jpi/context" "@jpi/repository" "@jpi/branch"
    row "@jpi-guardian/review-mode" "@jpi-background/tasks" "@jpi-background/monitors" "@jpi-schedule/prompts" "@jpi/slot"
  }
  // built-in statuses to hide
}

// Claude Code-style rendering for the built-in tools' calls and results
style {
  enabled #true
}

// the Agent tool: spawn, steer, and watch subagents; /agents
subagents {
  enabled #true
  // max concurrent background agents
  max-concurrent 10
  // default max turns before wrap-up; 0 = unlimited
  default-max-turns 0
  // grace turns after wrap-up steer
  grace-turns 5
  // default join mode for background agents
  default-join-mode smart
  // validate subagent models against pi's enabledModels
  scope-models #true
  // abort extension load on a broken agent file instead of skipping it with a warning
  strict-agent-files #false
  // skip registering the built-in default agents (general-purpose, explore, plan)
  disable-default-agents #false
  // Agent tool description sent to the LLM: full, compact, or custom
  tool-description-mode full
  // show the Claude Code-style fleet list below the editor
  fleet-view #true
  // route `@handle message` at the prompt to that subagent: model, direct, or off
  agent-mentions model
  // persist subagent sessions by default, so @handle can resume one after it finishes
  remember-agents #true
  // above-editor agent widget: all, background (hide foreground), or off
  widget-mode off
  // write each subagent's .output transcript by default
  output-transcript #true
  // allow isolation: worktree to create a git worktree
  worktree-isolation #true
  // days an idle, clean worktree survives before the sweep removes it
  worktree-cleanup-period-days 30
  // hard cap on nested subagent delegation depth; 0 or 1 disables nesting
  max-subagent-depth 2
  // agent type substituted when subagent_type is unknown, disabled, or ambiguous; #false rejects the call instead
  fallback-subagent general-purpose
  // add subagent tokens and cost to this session's own totals
  report-usage #false
  // show an estimated dollar cost beside subagent token counts
  show-cost #false
  // name the model and thinking level on the widget's running rows
  show-model #false
  // how much of the conversation viewer's transcript renders as Markdown
  viewer-markdown assistant
}

// TaskCreate/TaskList/TaskGet/TaskUpdate, the task widget, /tasks
tasks {
  enabled #true
  // where the task list is stored — memory, session, or project
  scope "session"
  // when completed tasks are swept from the list
  auto-clear-completed "on_list_complete"
}

// activity-aware terminal tab titles
title {
  enabled #true
}

// web_search and web_fetch, backed by the ketch CLI
web {
  enabled #true
  backend "ddg"
}
